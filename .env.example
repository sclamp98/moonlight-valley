# Set these in Vercel: Project -> Settings -> Environment Variables (Production AND Preview). Never commit real values.

# From your Ably dashboard: App -> API Keys. Looks like  xxxxxx.yyyyyy:zzzzzzzzzzzzzzzzzzzzzzzz  (a colon in the middle).
# Recommended: create a key that only has Publish + Subscribe + Presence, limited to channels "mv:*".
ABLY_API_KEY=your-ably-api-key-here

# Any long random string (24+ characters). It signs invite codes, so only your server can make valid ones.
# Generate one:  openssl rand -base64 32
MV_ROOM_SECRET=generate-a-long-random-string
